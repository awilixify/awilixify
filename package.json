{
	"name": "awilixify",
	"description": "Transport-agnostic modular DI and CQRS framework for Awilix with Nest-like module patterns and strict type safety",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./http": {
			"types": "./dist/lib/http/index.d.ts",
			"import": "./dist/lib/http/index.js"
		},
		"./devtools": {
			"types": "./dist/lib/devtools/index.d.ts",
			"import": "./dist/lib/devtools/index.js"
		},
		"./react": {
			"types": "./dist/lib/react/index.d.ts",
			"import": "./dist/lib/react/index.js"
		}
	},
	"version": "3.1.3",
	"license": "MIT",
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"build:release": "del-cli dist && npm run lint && npm run build",
		"check-types": "tsc --pretty --noEmit",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"lint:fix": "biome check --write lib test index.ts",
		"lint": "biome check lib test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:types": "tstyche",
		"test:types:watch": "tstyche --watch"
	},
	"peerDependencies": {
		"awilix": ">=9.0.0",
		"react": ">=18.0.0 || >=19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.15",
		"@shikijs/vitepress-twoslash": "^4.0.2",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^22.15.21",
		"@types/react": "^19.2.7",
		"@vitest/coverage-v8": "^4.0.18",
		"del-cli": "^7.0.0",
		"happy-dom": "^20.0.11",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"tstyche": "^5.0.2",
		"typescript": "^5.9.3",
		"vite": "^6.4.2",
		"vitepress": "^1.6.4",
		"vitest": "^4.0.18"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git://github.com/awilixify/awilixify.git"
	},
	"keywords": [
		"modular",
		"dependency-injection",
		"di",
		"modularization",
		"awilix",
		"cqrs",
		"mediator"
	],
	"homepage": "https://github.com/awilixify/awilixify",
	"files": [
		"README.md",
		"LICENSE",
		"dist/*"
	]
}
